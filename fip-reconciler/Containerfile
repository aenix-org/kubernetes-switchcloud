FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY *.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /fip-reconciler .

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /fip-reconciler /fip-reconciler
ENTRYPOINT ["/fip-reconciler"]
